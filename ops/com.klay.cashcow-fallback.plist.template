<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.klay.cashcow-fallback</string>

  <!-- 解释器铁律：/opt/homebrew/bin/python3。Apple CLT 的 python 被 TCC 拦在 ~/Documents 外。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__CHECKOUT__/ops/fallback_dispatch.py</string>
  </array>

  <!-- 用 StartInterval 每小时跑一次，而不是 StartCalendarInterval 钉死某个本地钟点：
       本机换时区（出差/回国）时，钉死的本地钟点会整体平移到美东盘中甚至凌晨，
       闹钟就"还在，但永远不到点"——静默失效正是这套系统最忌讳的死法。
       每小时跑一次则与本机时区无关，脚本自己用美东时间判 18:00 之前直接退出，
       单次开销是一次 API 读、零点几秒。 -->
  <key>StartInterval</key><integer>3600</integer>

  <key>StandardOutPath</key><string>__CHECKOUT__/ops/fallback.log</string>
  <key>StandardErrorPath</key><string>__CHECKOUT__/ops/fallback.log</string>

  <!-- launchd 的 PATH 极简；gh 与 git 都要能找到。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
